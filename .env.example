# BioLens Environment Configuration
# Copy this file to .env and fill in your own API keys

# NVIDIA NIM API Key for LLM-based botanical enrichment
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Pl@ntNet API Key for plant identification
# Get your key from: https://my.plantnet.org/
PLANTNET_API_KEY=your_plantnet_api_key_here

# Supabase credentials
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
